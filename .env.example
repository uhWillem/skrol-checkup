# Poort en pad van de MCP-server. Een moeilijk te raden pad helpt zolang er geen login is.
PORT=8080
MCP_PATH=/mcp
# Optioneel: sleutel die Claude meestuurt (header x-api-key of Authorization: Bearer).
API_KEY=
# Domeinen die de tool mag openen, gescheiden door komma's. *.domein.be voor subdomeinen.
ALLOWED_DOMAINS=*.webflow.io
# Vangnet en snelheid
MAX_PAGES=1000
PAGE_CONCURRENCY=2
JOB_CONCURRENCY=1
VIEWPORTS=1440,1280,992,768,390,360
PAGE_TIMEOUT_MS=30000
LINK_TIMEOUT_MS=10000
LINK_CONCURRENCY=8
DATA_DIR=/data
# Webflow-lezer: sitetokens met enkel leesrechten (Sites, Pages en CMS: read), gescheiden door komma's.
# Maak ze in Webflow: Site settings > Apps & integrations > API access > Generate API token.
WEBFLOW_TOKENS=
